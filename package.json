{
  "name": "mip",
  "version": "0.1.0",
  "private": true,
  "description": "AIOS that routes tasks to model providers, starting with the local Claude CLI",
  "type": "module",
  "main": "dist/backend/cli/index.js",
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p src/backend/tsconfig.json",
    "build:frontend": "vite build --config src/frontend/vite.config.ts",
    "start": "node dist/backend/cli/index.js",
    "serve": "node dist/backend/http/server.js",
    "dev": "npm run build:backend && node dist/backend/cli/index.js",
    "dev:frontend": "vite --config src/frontend/vite.config.ts",
    "typecheck": "tsc --noEmit -p src/backend/tsconfig.json && tsc --noEmit -p src/frontend/tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "daisyui": "^5.7.50",
    "preact": "^11.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "typebox": "^1.4.3"
  }
}
